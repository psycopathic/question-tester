{
  "type": "APL",
  "version": "1.8",
  "theme": "dark",
  "background": "#0A36A0",
  "graphics": {
    "cornerWave": {
      "type": "AVG",
      "version": "1.2",
      "width": 200,
      "height": 60,
      "items": [
        {
          "type": "path",
          "pathData": "M0,0 L200,0 C175,14 160,8 140,18 C120,28 105,16 85,26 C65,36 55,56 34,48 C18,42 12,54 0,60 Z",
          "fill": "#FFC928"
        }
      ]
    },
    "ringCluster": {
      "type": "AVG",
      "version": "1.2",
      "width": 100,
      "height": 160,
      "items": [
        {
          "type": "path",
          "pathData": "M100,0 A80,80 0 0 0 100,160 Z",
          "fill": "#FFC928"
        },
        {
          "type": "path",
          "pathData": "M100,28 A52,52 0 0 0 100,132",
          "fill": "transparent",
          "stroke": "#0D47C4",
          "strokeWidth": 4
        }
      ]
    },
    "dot": {
      "type": "AVG",
      "version": "1.2",
      "width": 20,
      "height": 20,
      "items": [
        {
          "type": "path",
          "pathData": "M10,3 A7,7 0 1 1 9.99,3 Z",
          "fill": "transparent",
          "stroke": "#FFFFFF",
          "strokeWidth": 2
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "justifyContent": "center",
        "paddingTop": "${viewport.height < 600 ? 14 : 32}",
        "paddingBottom": "${viewport.height < 600 ? 14 : 32}",
        "paddingLeft": "${viewport.shape == 'round' ? 72 : (viewport.height < 600 ? 96 : 170)}",
        "paddingRight": "${viewport.shape == 'round' ? 72 : (viewport.height < 600 ? 96 : 170)}",
        "items": [
          {
            "type": "VectorGraphic",
            "source": "cornerWave",
            "position": "absolute",
            "top": 0,
            "left": 0,
            "width": "${viewport.height < 600 ? 240 : 360}",
            "height": "${viewport.height < 600 ? 72 : 108}",
            "scale": "best-fit"
          },
          {
            "type": "VectorGraphic",
            "source": "ringCluster",
            "position": "absolute",
            "top": "${viewport.height < 600 ? 40 : 70}",
            "right": 0,
            "width": "${viewport.height < 600 ? 70 : 110}",
            "height": "${viewport.height < 600 ? 112 : 176}",
            "scale": "best-fit"
          },
          {
            "type": "VectorGraphic",
            "source": "ringCluster",
            "position": "absolute",
            "bottom": "${viewport.height < 600 ? 24 : 40}",
            "left": "${viewport.height < 600 ? -8 : -12}",
            "width": "${viewport.height < 600 ? 60 : 90}",
            "height": "${viewport.height < 600 ? 96 : 144}",
            "scale": "best-fit",
            "transform": [
              {
                "rotate": 180
              }
            ]
          },
          {
            "type": "VectorGraphic",
            "source": "dot",
            "position": "absolute",
            "top": "${viewport.height * 0.4}",
            "left": "${viewport.height < 600 ? 44 : 70}",
            "width": 18,
            "height": 18
          },
          {
            "type": "Container",
            "direction": "row",
            "justifyContent": "spaceBetween",
            "alignItems": "center",
            "items": [
              {
                "type": "Text",
                "text": "${payload.screen.batchName} · ${payload.screen.modeLabel}",
                "fontSize": "${viewport.height < 600 ? 16 : 22}",
                "color": "#DBEAFE",
                "shrink": 1,
                "maxLines": 1
              },
              {
                "type": "Text",
                "text": "${payload.screen.progress}",
                "fontSize": "${viewport.height < 600 ? 16 : 22}",
                "fontWeight": "700",
                "color": "#FFC928",
                "spacing": 16,
                "maxLines": 1
              }
            ]
          },
          {
            "type": "Container",
            "width": "100%",
            "height": "${viewport.height < 600 ? 150 : 230}",
            "spacing": "${viewport.height < 600 ? 10 : 16}",
            "items": [
              {
                "type": "Frame",
                "position": "absolute",
                "top": 0,
                "bottom": 0,
                "left": 0,
                "right": 0,
                "borderRadius": 20,
                "borderWidth": 2,
                "borderColor": "#FFC928",
                "backgroundColor": "#0B3AA8"
              },
              {
                "type": "Text",
                "text": "${payload.screen.question}",
                "width": "100%",
                "height": "100%",
                "textAlign": "center",
                "textAlignVertical": "center",
                "paddingLeft": 24,
                "paddingRight": 24,
                "fontStyle": "italic",
                "fontWeight": "700",
                "fontSize": "${viewport.shape == 'round' ? 20 : (viewport.height < 600 ? 32 : 46)}",
                "color": "#FFFFFF",
                "maxLines": 3
              }
            ]
          },
          {
            "type": "Container",
            "width": "100%",
            "spacing": "${viewport.height < 600 ? 12 : 20}",
            "items": [
              {
                "type": "Frame",
                "position": "absolute",
                "top": 0,
                "bottom": 0,
                "left": 0,
                "right": 0,
                "borderRadius": 20,
                "borderWidth": 1,
                "borderColor": "#93C5FD"
              },
              {
                "type": "Container",
                "paddingLeft": "${viewport.height < 600 ? 14 : 24}",
                "paddingRight": "${viewport.height < 600 ? 14 : 24}",
                "paddingTop": "${viewport.height < 600 ? 14 : 24}",
                "paddingBottom": "${viewport.height < 600 ? 14 : 24}",
                "data": "${payload.screen.rows}",
                "items": [
                  {
                    "type": "Container",
                    "direction": "row",
                    "width": "100%",
                    "spacing": "${viewport.height < 600 ? 10 : 16}",
                    "data": "${data}",
                    "items": [
                      {
                        "type": "Container",
                        "width": 0,
                        "grow": 1,
                        "spacing": 12,
                        "height": "${viewport.height < 600 ? 58 : 88}",
                        "items": [
                          {
                            "type": "Frame",
                            "position": "absolute",
                            "top": 0,
                            "bottom": 0,
                            "left": 0,
                            "right": 0,
                            "borderRadius": "${viewport.height < 600 ? 29 : 44}",
                            "borderWidth": 2,
                            "borderColor": "#FFFFFF",
                            "backgroundColor": "${data.isSelected ? '#FFC928' : 'transparent'}"
                          },
                          {
                            "type": "Text",
                            "text": "${data.id}.  ${data.text}",
                            "height": "100%",
                            "textAlignVertical": "center",
                            "paddingLeft": "${viewport.height < 600 ? 20 : 30}",
                            "paddingRight": "${viewport.height < 600 ? 14 : 24}",
                            "fontStyle": "italic",
                            "fontWeight": "500",
                            "fontSize": "${viewport.shape == 'round' ? 14 : (viewport.height < 600 ? 19 : 28)}",
                            "color": "${data.isSelected ? '#082A87' : '#FFFFFF'}",
                            "maxLines": 2
                          }
                        ]
                      }
                    ]
                  }
                ],
                "width": "100%"
              }
            ]
          }
        ]
      }
    ]
  }
}
